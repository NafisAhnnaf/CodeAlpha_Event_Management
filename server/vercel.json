{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/src/index.ts"
    },
    {
      "source": "/health",
      "destination": "/src/index.ts"
    },
    {
      "source": "/((?!api/|health|assets/|banners/|favicon.svg|icons.svg).*)",
      "destination": "/index.html"
    }
  ]
}
